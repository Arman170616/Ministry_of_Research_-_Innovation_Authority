# Copy to backend/.env and fill in for production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Claude (AI analysis). Leave empty to turn AI off; matching then falls back to keyword overlap.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_RATE_LIMIT=60/hour
